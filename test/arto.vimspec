Describe arto
  It loads plugin
    Assert exists('g:loaded_arto')
  End

  It defines :Arto command
    Assert exists(':Arto')
  End

  It defines :ArtoVersion command
    Assert exists(':ArtoVersion')
  End

  It sets default g:arto_path based on OS
    if has('mac')
      Assert Equals(g:arto_path, '/Applications/Arto.app')
    else
      Assert Equals(g:arto_path, 'arto')
    endif
  End

  It does not throw on missing executable
    let g:arto_path = '/nonexistent/path'
    call arto#open()
    call arto#open('foo.md')
    call arto#open('foo.md', 'bar.md')
    call arto#version()
    if has('mac')
      let g:arto_path = '/Applications/Arto.app'
    else
      let g:arto_path = 'arto'
    endif
  End

  It does not throw on unnamed buffer
    enew
    call arto#open()
    bwipeout
  End
End
